# FusionWorkspace environment variables template
# Copy to .env and fill in your values

# ---- LLM Providers ----
# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI / OpenAI-compatible (MiniMax, DeepSeek, Groq, Ollama)
OPENAI_API_KEY=

# ---- Embedding ----
EMBEDDING_ENDPOINT=http://localhost:11434/api/embeddings
EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=  # only needed for cloud embedding services

# ---- FusionWorkspace Runtime ----
FUSION_PORT=8080
FUSION_MODE=server

# ---- Memory ----
# FUSION_MEMORY_DB_PATH=~/.fusion-workspace/memory.db

# ---- External Channels (optional) ----
# WeChat
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_TOKEN=
# WECHAT_ENCODING_AES_KEY=

# Feishu
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
